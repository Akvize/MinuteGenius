# Required only for the `meeting` command (vision analysis, speaker ID, write-up).
# Any OpenAI-compatible endpoint works: Scaleway, OpenRouter, Groq, a local Ollama/vLLM, etc.
AI_API=https://api.scaleway.ai/v1
AI_KEY=your_api_key_here

# Text model used to write/clean up the report (steps 5-6). Optional — falls back to a sane default.
AI_MODEL_WRITER=deepseek-v4-flash

# Vision model used for frame analysis and speaker identification (steps 2 and 4). Optional.
AI_MODEL_IMAGE=qwen3.6-27b

# Optional: use a separate endpoint/key/model for vision calls (e.g. a cheaper or faster vision model).
#AI_API2=
#AI_KEY2=
#AI_MODEL_IMAGE2=

# Number of frames analyzed in parallel during step 2 (default: 3).
#AI_PARALLEL_IMAGES=3
