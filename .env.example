# Required only for the `meeting` command (vision analysis, speaker ID, write-up).
# Any OpenAI-compatible endpoint works: your own provider's gateway, OpenRouter,
# Groq, a local Ollama/vLLM server, etc.
AI_API=https://api.your-provider.com/v1
AI_KEY=your_api_key_here

# Text model used to write/clean up the report (steps 5-6). Any text-capable
# model works — pick whatever your provider offers.
AI_MODEL_WRITER=your-text-model-id

# Vision model used for frame analysis and speaker identification (steps 2
# and 4). gpt-5-nano is a good cheap default if your provider offers it.
AI_MODEL_IMAGE=gpt-5-nano

# Optional: use a separate endpoint/key/model for vision calls (e.g. a cheaper
# or faster vision model than your text one).
#AI_API2=
#AI_KEY2=
#AI_MODEL_IMAGE2=

# Number of frames analyzed in parallel during step 2 (default: 3).
#AI_PARALLEL_IMAGES=3

# --- Fallback transcription (Windows/Linux, or Mac without argmax-cli) ---
# Used only when neither `argmax-cli` nor `whisperkit-cli` is found on PATH
# (or when --cloud is passed). Independent of
# AI_API/AI_KEY above, which configure the summarization model instead.
#
# pyannote.ai API key, for transcription + speaker diarization (who-said-what)
# in a single call. Get one at https://www.pyannote.ai
#PYANNOTE_API_KEY=...
#
# Optional: transcription model used for that call. Defaults to
# faster-whisper-large-v3-turbo (99+ languages) if unset. The other option,
# parakeet-tdt-0.6b-v3, covers 27 languages.
#PYANNOTE_TRANSCRIPTION_MODEL=faster-whisper-large-v3-turbo
